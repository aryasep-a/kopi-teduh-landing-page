---
import {categories,menu,rupiah} from '../data/menu';
---
<section class="section" id="menu"><div class="container"><div class="heading"><h2>Menu Pilihan</h2><div class="tabs" role="tablist" aria-label="Kategori menu">{categories.map((c,i)=><button class="tab" id={'tab-'+i} role="tab" aria-selected={i===0?'true':'false'} aria-controls="menu-panel" tabindex={i===0?0:-1} data-category={c}>{c}</button>)}</div></div><div class="cards" id="menu-panel" role="tabpanel" aria-labelledby="tab-0" tabindex="0">{menu.map(m=><article class="card" data-menu-category={m[3]} hidden={m[3]!=='Kopi'}><div class="card-art"><span class="cup"></span></div><div class="cardbody"><div class="cardtop"><h3>{m[0]}</h3><span class="price">{rupiah(m[2])}</span></div><p>{m[1]}</p></div></article>)}</div></div></section><script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-menu-category]'));const panel=document.querySelector<HTMLElement>('#menu-panel');const activate=(t:HTMLButtonElement)=>{tabs.forEach(x=>{const s=x===t;x.setAttribute('aria-selected',String(s));x.tabIndex=s?0:-1});cards.forEach(c=>c.hidden=c.dataset.menuCategory!==t.dataset.category);panel?.setAttribute('aria-labelledby',t.id)};tabs.forEach((t,i)=>{t.addEventListener('click',()=>activate(t));t.addEventListener('keydown',e=>{if(!['ArrowRight','ArrowLeft','Home','End'].includes(e.key))return;e.preventDefault();const n=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;tabs[n]?.focus();activate(tabs[n]!)})});
</script>