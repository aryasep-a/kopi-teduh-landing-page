---
import PhotoArt from './PhotoArt.astro';
---
<section class="section" id="suasana"><div class="container"><div class="heading"><h2>Suasana di Teduh</h2></div><div class="gallery">
<button data-lightbox aria-label="Perbesar foto interior kedai dengan pencahayaan hangat"><PhotoArt kind="interior" label="Interior kedai dengan meja kayu dan cahaya hangat" sizes="(max-width: 767px) 100vw, 40vw"/></button>
<button data-lightbox aria-label="Perbesar foto area bar dan peralatan seduh"><PhotoArt kind="bar" label="Area bar dengan mesin espresso dan perlengkapan seduh" sizes="(max-width: 767px) 50vw, 25vw"/></button>
<button data-lightbox aria-label="Perbesar foto area duduk di teras kedai"><PhotoArt kind="terrace" label="Area duduk teras dengan tanaman dan kursi kayu" sizes="(max-width: 767px) 50vw, 25vw"/></button>
</div></div></section>
<div class="lightbox" role="dialog" aria-modal="true" aria-label="Pratinjau foto" hidden><button type="button" aria-label="Tutup pratinjau">×</button><div id="lightbox-art"></div></div>
<script>
const box=document.querySelector<HTMLElement>('.lightbox');const art=document.querySelector<HTMLElement>('#lightbox-art');let opener:HTMLButtonElement|null=null;
const close=()=>{if(!box)return;box.classList.remove('open');box.hidden=true;document.body.classList.remove('lock');opener?.focus()};
document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach(button=>button.addEventListener('click',()=>{const image=button.querySelector('img');if(!image||!art||!box)return;opener=button;art.replaceChildren(image.cloneNode(true));box.hidden=false;box.classList.add('open');document.body.classList.add('lock');box.querySelector('button')?.focus()}));
box?.querySelector('button')?.addEventListener('click',close);box?.addEventListener('click',event=>{if(event.target===box)close()});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&box&&!box.hidden)close()});
</script>