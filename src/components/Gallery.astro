---
import PhotoArt from './PhotoArt.astro';
---
<section class="section" id="suasana"><div class="container"><div class="heading"><h2>Suasana di Teduh</h2></div><div class="gallery"><button data-lightbox aria-label="Perbesar ilustrasi area dalam"><PhotoArt kind="interior" label="FOTO: area dalam, meja kayu"/></button><button data-lightbox aria-label="Perbesar ilustrasi bar"><PhotoArt kind="bar" label="FOTO: bar dan mesin espresso"/></button><button data-lightbox aria-label="Perbesar ilustrasi teras"><PhotoArt kind="terrace" label="FOTO: teras teduh"/></button></div></div></section><div class="lightbox" role="dialog" aria-modal="true" aria-label="Pratinjau gambar"><button type="button" aria-label="Tutup">×</button><div id="lightbox-art"></div></div><script>
const box=document.querySelector<HTMLElement>('.lightbox');const art=document.querySelector<HTMLElement>('#lightbox-art');const close=()=>{box?.classList.remove('open');document.body.classList.remove('lock')};document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach(b=>b.addEventListener('click',()=>{const svg=b.querySelector('svg');if(!svg||!art||!box)return;art.replaceChildren(svg.cloneNode(true));box.classList.add('open');document.body.classList.add('lock');box.querySelector('button')?.focus()}));box?.querySelector('button')?.addEventListener('click',close);box?.addEventListener('click',e=>{if(e.target===box)close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&box?.classList.contains('open'))close()});
</script>