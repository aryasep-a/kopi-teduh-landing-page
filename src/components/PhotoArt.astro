---
interface Props {
  kind?: 'hero' | 'beans' | 'interior' | 'bar' | 'terrace' | 'map';
  label?: string;
  class?: string;
}
const { kind = 'hero', label = 'Ilustrasi Kopi Teduh', class: className = '' } = Astro.props as Props;
const src = '/kopi-teduh-landing-page/images/' + kind + '.svg';
---
<div class:list={['photo', className]}>
  <img
    src={src}
    alt={label}
    width="900"
    height="700"
    loading={kind === 'hero' ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={kind === 'hero' ? 'high' : 'auto'}
  />
  <span class="photo-label" aria-hidden="true">{label}</span>
</div>
