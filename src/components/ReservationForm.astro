---
import { site, wa } from '../data/site';
---
<section class="reserve" id="reservasi"><div class="container reservegrid"><div><p class="eyebrow" style="color:#FFE0D0">Ada rencana mampir?</p><h2>Siap ngopi bareng?</h2><p>Amankan tempatmu. Isi detail singkat, kami lanjutkan lewat WhatsApp.</p><a class="button outline" href={wa('Halo Kopi Teduh, saya ingin bertanya tentang reservasi.')} target="_blank" rel="noopener noreferrer" data-cta="whatsapp-direct">Chat WhatsApp</a></div>
<form class="form" id="reservation-form" data-phone={site.whatsapp}>
<div class="field full"><label for="guest-name">Nama</label><input id="guest-name" name="name" required minlength="2" maxlength="60" autocomplete="name" placeholder="Nama kamu"/></div>
<div class="field"><label for="visit-date">Tanggal</label><input id="visit-date" name="date" type="date" required/></div>
<div class="field"><label for="visit-time">Jam</label><select id="visit-time" name="time" required disabled><option value="">Pilih tanggal terlebih dahulu</option></select></div>
<div class="field full"><label for="guest-count">Jumlah orang</label><select id="guest-count" name="guests" required><option value="">Pilih jumlah orang</option>{Array.from({length:12},(_,i)=><option value={String(i+1)}>{i+1} orang</option>)}</select></div>
<p class="error" id="form-error" role="alert"></p><button class="button" type="submit" data-cta="reservation-form">Kirim reservasi via WhatsApp</button>
</form></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#reservation-form');const dateInput=document.querySelector<HTMLInputElement>('#visit-date');const timeSelect=document.querySelector<HTMLSelectElement>('#visit-time');const error=document.querySelector<HTMLElement>('#form-error');const pad=(n:number)=>String(n).padStart(2,'0');
const today=new Date();if(dateInput)dateInput.min=[today.getFullYear(),pad(today.getMonth()+1),pad(today.getDate())].join('-');
const updateTimeOptions=()=>{if(!dateInput||!timeSelect)return;timeSelect.replaceChildren(new Option('Pilih jam',''));if(!dateInput.value){timeSelect.disabled=true;timeSelect.options[0].textContent='Pilih tanggal terlebih dahulu';return}const weekday=new Date(dateInput.value+'T12:00:00').getDay();const opensAt=weekday===0||weekday===6?7:8;const closesAt=weekday===0||weekday===6?23:22;for(let hour=opensAt;hour<closesAt;hour++){const value=pad(hour)+':00';timeSelect.add(new Option(value.replace(':','.'),value))}timeSelect.disabled=false};
dateInput?.addEventListener('change',()=>{updateTimeOptions();if(error)error.textContent=''});
form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);if(String(data.get('date'))<(dateInput?.min??'')){if(error)error.textContent='Pilih tanggal hari ini atau setelahnya.';dateInput?.focus();return}if(!timeSelect||!Array.from(timeSelect.options).some(option=>option.value===data.get('time'))){if(error)error.textContent='Pilih jam sesuai waktu operasional kedai.';timeSelect?.focus();return}const message=['Halo Kopi Teduh, saya ingin reservasi meja.','','Nama: '+data.get('name'),'Tanggal: '+data.get('date'),'Jam: '+data.get('time'),'Jumlah orang: '+data.get('guests')].join('\n');window.open('https://wa.me/'+form.dataset.phone+'?text='+encodeURIComponent(message),'_blank','noopener,noreferrer');if(error)error.textContent=''});
</script>