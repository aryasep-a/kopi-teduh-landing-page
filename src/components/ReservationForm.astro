---
import {site,wa} from '../data/site';
---
<section class="reserve" id="reservasi"><div class="container reservegrid"><div><p class="eyebrow" style="color:#FFE0D0">Ada rencana mampir?</p><h2>Siap ngopi bareng?</h2><p>Amankan tempatmu. Isi detail singkat, kami lanjutkan lewat WhatsApp.</p><a class="button outline" href={wa('Halo Kopi Teduh, saya ingin bertanya tentang reservasi.')} target="_blank" rel="noopener noreferrer" data-cta="whatsapp-direct">Chat WhatsApp</a></div><form class="form" id="reservation-form" data-phone={site.whatsapp}><div class="field full"><label for="guest-name">Nama</label><input id="guest-name" name="name" required minlength="2" maxlength="60" autocomplete="name" placeholder="Nama kamu"/></div><div class="field"><label for="visit-date">Tanggal</label><input id="visit-date" name="date" type="date" required/></div><div class="field"><label for="visit-time">Jam</label><select id="visit-time" name="time" required><option value="">Pilih jam</option>{Array.from({length:15},(_,i)=>{const h=String(i+8).padStart(2,'0');return <option value={h+':00'}>{h}:00</option>})}</select></div><div class="field full"><label for="guest-count">Jumlah orang</label><select id="guest-count" name="guests" required><option value="">Pilih jumlah orang</option>{Array.from({length:12},(_,i)=><option value={String(i+1)}>{i+1} orang</option>)}</select></div><p class="error" id="form-error" role="alert"></p><button class="button" type="submit" data-cta="reservation-form">Kirim reservasi via WhatsApp</button></form></div></section><script>
const form=document.querySelector<HTMLFormElement>('#reservation-form');const date=document.querySelector<HTMLInputElement>('#visit-date');const error=document.querySelector<HTMLElement>('#form-error');if(date)date.min=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);form?.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const d=new FormData(form);if(String(d.get('date'))<(date?.min??'')){if(error)error.textContent='Pilih tanggal hari ini atau setelahnya.';date?.focus();return}const message=['Halo Kopi Teduh, saya ingin reservasi meja.','','Nama: '+d.get('name'),'Tanggal: '+d.get('date'),'Jam: '+d.get('time'),'Jumlah orang: '+d.get('guests')].join('\n');window.open('https://wa.me/'+form.dataset.phone+'?text='+encodeURIComponent(message),'_blank','noopener,noreferrer');if(error)error.textContent=''});
</script>