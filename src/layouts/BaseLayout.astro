---
import '../styles/global.css';import {site} from '../data/site';const {title=site.tagline,description=site.description}=Astro.props;const index=import.meta.env.PUBLIC_ALLOW_INDEXING==='true';const canonical=site.canonical+(Astro.url.pathname.includes('/menu')?'menu/':'');const specs=site.hours.flatMap(h=>h.schema.map(day=>({'@type':'OpeningHoursSpecification',dayOfWeek:'https://schema.org/'+day,opens:h.open,closes:h.close})));const schema={'@context':'https://schema.org','@type':'CafeOrCoffeeShop',name:site.name,description,telephone:'+62-812-0000-0000',priceRange:site.priceRange,url:canonical,address:{'@type':'PostalAddress',streetAddress:site.address.street,addressLocality:site.address.city,addressRegion:site.address.region,postalCode:'15117',addressCountry:'ID'},openingHoursSpecification:specs,sameAs:[site.socials.instagram,site.socials.tiktok],hasMenu:{'@type':'Menu',name:'Menu Kopi Teduh'}};
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#F5EFE6"/><title>{title} | Kopi Teduh</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={index?'index,follow':'noindex,nofollow'}/><meta property="og:type" content="website"/><meta property="og:locale" content="id_ID"/><meta property="og:title" content={title+' | Kopi Teduh'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={site.canonical+'og-image.svg'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title + " | Kopi Teduh"}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={site.canonical+'og-image.svg'}/><link rel="icon" href="/kopi-teduh-landing-page/favicon.ico" sizes="any"/><link rel="icon" href="/kopi-teduh-landing-page/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/kopi-teduh-landing-page/apple-touch-icon.png"/><link rel="manifest" href="/kopi-teduh-landing-page/site.webmanifest"/><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></head><body><a class="skip" href="#konten">Lewati ke konten</a><slot/></body></html>