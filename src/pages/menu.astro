---
import BaseLayout from '../layouts/BaseLayout.astro';import Navbar from '../components/Navbar.astro';import {categories,menu,rupiah} from '../data/menu';
---
<BaseLayout title="Menu lengkap"><Navbar/><main id="konten" class="container section"><p class="eyebrow">Dari bar dan dapur kami</p><h1>Menu lengkap.</h1>{categories.map(c=><section style="padding-top:40px"><h2>{c}</h2><div class="cards" style="padding-top:20px">{menu.filter(m=>m[3]===c).map(m=><article class="card"><div class="card-art"><span class="cup"></span></div><div class="cardbody"><div class="cardtop"><h3>{m[0]}</h3><span class="price">{rupiah(m[2])}</span></div><p>{m[1]}</p></div></article>)}</div></section>)}</main></BaseLayout>