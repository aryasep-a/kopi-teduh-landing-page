---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PhotoArt from '../components/PhotoArt.astro';
import MenuSection from '../components/MenuSection.astro';
import Gallery from '../components/Gallery.astro';
import ReservationForm from '../components/ReservationForm.astro';
import { site, wa } from '../data/site';
import { testimonials } from '../data/testimonials';
---
<BaseLayout title="Duduk dulu, kopinya menyusul">
<Navbar/>
<main id="konten">
<section class="hero" id="beranda"><div class="container hero-grid"><div><p class="eyebrow">Kedai kopi · sejak 2019</p><h1>Duduk dulu,<br/>kopinya<br/>menyusul.</h1><p class="intro">Biji pilihan dari petani lokal, disangrai kecil-kecilan setiap pekan, diseduh pelan di ruang yang teduh.</p><div class="actions"><a class="button" href="#menu" data-cta="hero-menu">Lihat Menu</a><a class="button outline" href="#lokasi">Cara ke Sini</a></div><div class="meta-row"><div class="meta"><strong>Buka Setiap Hari</strong><span>08.00 – 22.00</span></div><div class="meta"><strong>Wi-Fi &amp; Colokan</strong><span>Tersedia di seluruh area</span></div></div></div><PhotoArt kind="hero" class="hero-photo" label="Tiga cangkir kopi tersaji bersama di meja kedai" loading="eager"/></div></section>
<section class="benefits"><div class="container"><h2 class="sr-only">Keunggulan Kopi Teduh</h2><div class="benefit-grid"><article class="benefit"><h3>Biji Single Origin</h3><p>Dari kebun mitra di Jawa, Sumatra, dan Flores.</p></article><article class="benefit"><h3>Sangrai Mingguan</h3><p>Selalu segar, tidak dibiarkan terlalu lama.</p></article><article class="benefit"><h3>Ruang untuk Berlama-lama</h3><p>Kerja, belajar, atau sekadar ngobrol panjang.</p></article></div></div></section>
<MenuSection/>
<section class="story" id="cerita"><div class="container story-grid"><PhotoArt kind="beans" class="story-photo" label="Biji kopi pilihan yang baru selesai disangrai"/><div class="story-copy"><p class="eyebrow">Cerita kami</p><h2>Dari kebun ke cangkir,<br/>tanpa banyak perantara.</h2><p>Kami bekerja langsung dengan petani mitra, menyangrai dalam batch kecil, lalu menyeduhnya di depanmu. Sederhana, jujur, dan selalu hangat.</p><a href="#lokasi">Temukan kedai kami</a></div></div></section>
<Gallery/>
<section class="section testimonials" aria-labelledby="testimonials-heading"><div class="container"><div class="heading"><h2 id="testimonials-heading">Cerita dari pengunjung</h2></div><div class="testimonial-grid">{testimonials.map(item=><figure class="testimonial-card"><blockquote>“{item.quote}”</blockquote><figcaption><strong>{item.name}</strong><span>{item.detail}</span></figcaption></figure>)}</div><p class="sample-note">Testimoni merupakan konten fiktif untuk kebutuhan demonstrasi portfolio.</p></div></section>
<section class="section" id="lokasi"><div class="container visit"><div><h2>Mampir ke Teduh</h2><p class="address">{site.address.full}</p><div class="hours">{site.hours.map(hours=><div><span>{hours.days}</span><strong>{hours.open.replace(':','.')} – {hours.close.replace(':','.')}</strong></div>)}</div><a class="button green" href={site.maps} target="_blank" rel="noopener noreferrer" data-cta="google-maps">Buka di Google Maps</a><p class="address">WhatsApp: {site.phone}</p></div><PhotoArt kind="map" class="mapart" label="Suasana interior kedai dengan meja dan kursi untuk pengunjung"/></div></section>
<ReservationForm/>
</main>
<footer class="container footer"><a class="brand" href="#beranda">Kopi Teduh</a><div class="footlinks"><a href={site.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={site.socials.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={wa('Halo Kopi Teduh!')} target="_blank" rel="noopener noreferrer">WhatsApp</a></div><div class="footer-note"><a href="https://aryaseptian.my.id" target="_blank" rel="noopener noreferrer">aryaseptian.my.id</a><small>Template sample usaha fiktif untuk portfolio web designer.</small></div></footer>
<a class="mobile-cta" href={wa('Halo Kopi Teduh, saya ingin reservasi meja.')} target="_blank" rel="noopener noreferrer" data-cta="mobile-whatsapp">Reservasi via WhatsApp</a>
</BaseLayout>
<script>
const isDesktop=window.matchMedia('(min-width:768px)').matches;
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(isDesktop&&!reduceMotion&&'IntersectionObserver' in window){
  const targets=document.querySelectorAll<HTMLElement>('.benefit-grid,.story-grid,.gallery,.testimonial-grid,.visit,.reservegrid');
  targets.forEach(element=>element.classList.add('reveal'));
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
    if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}
  }),{threshold:.12});
  targets.forEach(element=>observer.observe(element));
}
</script>